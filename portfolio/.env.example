# Port for the API server (also serves the built site from ./dist)
PORT=8787

# Chat: any OpenAI-compatible endpoint. Ollama exposes one at /v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# Speech: Speaches (faster-whisper + Kokoro) exposes OpenAI-compatible
# /v1/audio/transcriptions and /v1/audio/speech. Leave empty to fall back to the
# browser's built-in speech recognition/synthesis.
SPEECH_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
