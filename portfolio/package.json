{
  "name": "priyansh-ai-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -p . && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9",
    "typescript": "^5.9",
    "vite": "^8.3.2"
  }
}
